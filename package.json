{
  "name": "kozy-living",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run protection:config && npm run shield:check && node scripts/verify-worker-secrets.mjs && npm run cf:check && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types cloudflare/worker-configuration.d.ts",
    "cf:check": "npm run cf-typegen && tsc -p cloudflare && node --test cloudflare/*.test.ts scripts/*.test.mjs",
    "shield:apply": "node --env-file-if-exists=.env.protection.local scripts/cloudflare-shield.mjs apply",
    "shield:check": "node --env-file-if-exists=.env.protection.local scripts/cloudflare-shield.mjs check",
    "protection:config": "node scripts/protection-config.mjs",
    "protection:secrets": "node scripts/upload-worker-secrets.mjs",
    "protection:live": "node scripts/store-check.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.1.5",
    "@opennextjs/cloudflare": "^1.20.17",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "^16.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/typography": "^0.5.14",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "playwright": "^1.63.0",
    "postcss": "^8.5.26",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "wrangler": "^4.164.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.4"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261117.1": true
  }
}
