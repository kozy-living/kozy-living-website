/**
 * Cloudflare Workers deployment for kozyliving.in.
 * Setup, dashboard settings and the reasons are in docs/cloudflare-hosting.md.
 *
 * Before the first deploy, create the two stores this names (once):
 *   npx wrangler r2 bucket create kozy-living-opennext-cache
 *   npx wrangler d1 create kozy-living-tag-cache   -> paste its id below
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kozy-living",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-17",
  // nodejs_compat: Next's server needs Node APIs (Buffer, AsyncLocalStorage).
  // global_fetch_strictly_public: a fetch to our own hostname goes out and
  // back in through the zone, so it reaches the static assets instead of
  // looping straight back into this worker.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Only the real domains serve the site. A `*.workers.dev` host or a preview
  // URL would be a second, crawlable copy of the store on the same quota
  // (the Vercel preview hosts were exactly that).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "kozyliving.in", "custom_domain": true },
    // Served by this worker only to be 308'd to the apex by next.config.js.
    { "pattern": "www.kozyliving.in", "custom_domain": true }
  ],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // The memory queue re-renders a stale ISR page by calling this worker.
    { "binding": "WORKER_SELF_REFERENCE", "service": "kozy-living" }
  ],
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "kozy-living-opennext-cache" }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "kozy-living-tag-cache",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  // `/_next/image` only ever resizes the small local files in `public/`;
  // Shopify photographs go straight to Shopify's CDN through `ShopImage`.
  "images": { "binding": "IMAGES" },

  // Workers Logs: request logs and console output, searchable in the
  // dashboard. Included in the Workers Paid plan.
  "observability": { "enabled": true }
}
