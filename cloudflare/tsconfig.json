{
  // Type-checks the Worker wrapper alone: `npx tsc -p cloudflare`.
  // Runtime and binding types come from `npm run cf-typegen`.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["worker.ts", "shop-cache.ts", "request-guard.ts", "shield.ts", "worker-configuration.d.ts"]
}
