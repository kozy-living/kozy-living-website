# Cloudflare Workers static-asset headers. Read by the assets binding and
# not served as a file. Next's own `headers()` in next.config.js never sees
# these requests: assets are answered before the worker runs.

# Hashed build output: the file name changes when the content does.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# A week, same as next.config.js headers(): long enough that a returning
# browser stops re-asking, short enough that a replaced file shows up.
/media/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/kozy/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/logo/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/newsletter/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/font/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon.ico
