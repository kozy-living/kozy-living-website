# Public, non-secret build settings for production builds (`next build`,
# `opennextjs-cloudflare build`). Committed on purpose: NEXT_PUBLIC_* values
# are inlined at BUILD time, and on Cloudflare the build has no
# VERCEL_PROJECT_PRODUCTION_URL to fall back on, so a missing value here
# would point every canonical, the sitemap and robots.txt at localhost.
# Secrets never go in this file - they are Worker secrets (docs/cloudflare-hosting.md).
NEXT_PUBLIC_SITE_URL=https://kozyliving.in

# Cloudflare Web Analytics site token (public: it is printed in every page).
# Dashboard -> Analytics & Logs -> Web Analytics -> Add a site -> kozyliving.in,
# then copy the `token` from the snippet it shows. Empty = no beacon.
NEXT_PUBLIC_CF_BEACON_TOKEN=
